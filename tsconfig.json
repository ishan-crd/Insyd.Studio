{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": { "@project/editor": ["./src/lib/no-project.ts"], "@project/sdk": ["./sdk/index.tsx"] }
  },
  "include": ["src", "sdk/index.tsx", "vite.config.ts"]
}
